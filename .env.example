# Postgres connection string (required by @workspace/db and drizzle-kit)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/heiba

# API server
PORT=5000
# NODE_ENV=development
# LOG_LEVEL=info

# HMAC secret for hashing session tokens (REQUIRED in production; random per
# process in development if unset)
# SESSION_SECRET=change-me-to-a-long-random-string

# Optional: bootstrap the initial OWNER account at server startup
# OWNER_EMAIL=owner@example.com
# OWNER_PASSWORD=change-me

# Override login rate limit (default 20 attempts / 15 min / IP)
# LOGIN_RATE_LIMIT=20
